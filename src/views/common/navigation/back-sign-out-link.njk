{# sendReferrer must only be set on pages whose back link needs the Referer header to chain correctly (e.g. footer pages) - it overrides the site-wide no-referrer policy #}
{% macro appBackSignOutLink(href, sendReferrer=false) %}
  {% from "govuk/components/back-link/macro.njk" import govukBackLink %}

  <div class="govuk-grid-row sub-header-container govuk-!-padding-top-3">
    {% if href %}
      <div class="govuk-grid-column-two-thirds">
        {{ govukBackLink({
          text: "Back",
          href: href,
          classes: "govuk-!-margin-top-0",
          attributes: { referrerpolicy: "same-origin" } if sendReferrer else {}
        }) }}
      </div>
    {% endif %}

    {% if auth.isAuthenticated %}
      <div class="govuk-grid-column-{% if href %}one-third{% else %}full{% endif %} govuk-!-text-align-right">
        <a href="/auth/sign-out" class="govuk-link govuk-link--no-visited-state">Sign out</a>
      </div>
    {% endif %}
  </div>
  <p class="govuk-body govuk-!-margin-bottom-0"></p>
{% endmacro %}
