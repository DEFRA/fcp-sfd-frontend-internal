{% macro appBreadcrumbsSignOutLink(params = {}) %}
  <div class="sub-header-container govuk-!-padding-top-3 govuk-clearfix">

    {% if auth.isAuthenticated %}
      <div class="login-nav login-nav-aligned govuk-!-margin-top-0{% if params.loginNavClasses %} {{ params.loginNavClasses }}{% endif %}">
        <ul class="login-nav__list">
          <li class="login-nav__list-item">
            <a
              href="{{ params.signOutHref or '/auth/sign-out' }}"
              class="govuk-link login-nav__link govuk-link--no-visited-state login-nav__sign-out-link"
            >
              {{ params.signOutText or 'Sign out' }}
            </a>
          </li>
        </ul>
      </div>
    {% endif %}

    {% if params.breadcrumbs and (params.breadcrumbs | length) %}
      <nav class="govuk-breadcrumbs govuk-!-margin-top-0" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
          {% for item in params.breadcrumbs %}
            <li class="govuk-breadcrumbs__list-item"{% if not item.href %} aria-current="page"{% endif %}>
              {% if item.href %}
                <a class="govuk-breadcrumbs__link" href="{{ item.href }}">{{ item.text }}</a>
              {% else %}
                {{ item.text }}
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      </nav>
    {% endif %}
  </div>
{% endmacro %}
